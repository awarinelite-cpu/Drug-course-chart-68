rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isKnownUser() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isSubadmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'subadmin';
    }
    // The nurse currently holding the Overall Nurse role for a given week
    // (see /nurseReportRoles/{weekId}) — used to gate first-time archiving.
    function isOverallForWeek(wid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/nurseReportRoles/$(wid))
        && get(/databases/$(database)/documents/nurseReportRoles/$(wid)).data.overallNurse.uid == request.auth.uid;
    }

    // User profiles / roles
    match /users/{uid} {
      allow read: if isKnownUser();
      allow create: if isSignedIn() && isAdmin();
      // Admins can update anything. A signed-in user may also edit their own
      // profile (name, phone, department, etc.) but may not change their own
      // role or email through this path.
      allow update: if isAdmin() || (
        isSignedIn() && request.auth.uid == uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.email == resource.data.email
      );
      allow delete: if isAdmin();

      // Push tokens for drug-due alerts (js/push.js). A nurse manages only
      // her own device tokens; the alert Cloud Function reads across all
      // users via the Admin SDK, which bypasses these rules entirely.
      match /pushTokens/{tokenId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Drug-due alarm policy (sound/appearance/repeat/quiet-hours/frequencies)
    // set by an admin in admin.html and applied on every device in
    // js/push.js. Any signed-in user needs read access — it's their own
    // device's alarm behavior that depends on it — but only an admin may
    // change ward-wide alarm policy.
    match /settings/{settingId} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }

    // Nurses Report config — admin-editable structure for the report
    // tables: wardNames (ward renames), headerLabels (column renames,
    // including the two grouped Transfer headers), and customColumns (new
    // text columns an admin has added). See overall-nurse.html's rename/
    // add-column actions and js/nurses-report-common.js. Any known user
    // reads it (it drives what's shown on the Overall Statistics table and
    // every ward report), but only an admin may change the structure.
    match /nurseReportConfig/{configId} {
      allow read: if isKnownUser();
      allow write: if isAdmin();
    }

    // Nurses Report — the weekly Overall Nurse assignment, and each day's
    // 24-hour ward census. Any known user may claim/hand off the Overall
    // Nurse role or edit ward figures — the app itself gates who sees the
    // Overall Nurse page, matching how admin-only UI is gated elsewhere
    // without every collection needing its own role check here.
    match /nurseReportRoles/{weekId} {
      allow read, write: if isKnownUser();
    }
    match /nurseReports/{dateId} {
      allow read, write: if isKnownUser();

      match /wards/{wardKey} {
        allow read, write: if isKnownUser();

        // Permanent, append-only log of every edit made to a ward's
        // statistics figures (see overall-nurse.html's saveField/
        // logHistory). Any known user who can edit the figures may add
        // an entry, but entries can never be changed or removed by
        // anyone — including an admin — and only admin/subadmin may
        // read the log, matching the History panel's visibility.
        match /history/{historyId} {
          allow read: if isAdmin() || isSubadmin();
          allow create: if isKnownUser();
          allow update, delete: if false;
        }
      }
    }

    // Ward Charts Archive — the finalized, permanent daily record. One
    // "overall_<dateId>" doc plus one "ward_<wardKey>_<dateId>" doc per
    // ward are created together (see nurses-report/overall-nurse.html's
    // Save to Archive action). Any known user may read/search the
    // archive. An "overall" entry may only be created by the Overall
    // Nurse for the report's week (checked via the weekId carried on the
    // write itself), an admin, or a subadmin — matching who sees that
    // batch action. A "ward" entry may be created by any known user,
    // matching how nurseReports/{dateId}/wards itself is already open to
    // any known user — this is what lets a single ward's "Move to
    // Archive" button (ward-nurse.html, and the per-ward action on the
    // Overall Nurse page) file that one ward's report without waiting on
    // the full batch. Once an entry exists, only an admin or subadmin may
    // change it (correcting a figure or note) — even the nurse or Overall
    // Nurse who filed it cannot edit it afterwards. Archive files are
    // permanent: delete is never allowed, by anyone.
    match /archives/{archiveId} {
      allow read: if isKnownUser();
      allow create: if isKnownUser()
        && (
          request.resource.data.type == 'ward'
          || isAdmin() || isSubadmin() || isOverallForWeek(request.resource.data.weekId)
        );
      allow update: if isAdmin() || isSubadmin();
      allow delete: if false;
    }

    // Patients and every chart subcollection under them
    match /patients/{patientId} {
      allow read, create, update: if isKnownUser();
      allow delete: if isAdmin();

      match /{chartCollection}/{chartDoc} {
        allow read, create, update, delete: if isKnownUser();
      }
    }

    // Per-nurse patient allocation (index.html's "Allocate to Me" button /
    // allocation.html's "My Patients" list). Not exclusive — more than one
    // nurse can allocate the same patient (e.g. a colleague lending a hand)
    // — so this is one doc per (nurse, patient) pair, id'd
    // "alloc_{uid}_{patientId}", not one doc per patient. Any signed-in
    // staff member can read the full list (useful for handover visibility),
    // but a nurse may only create/update/delete her own allocation docs —
    // never allocate or deallocate on someone else's behalf.
    match /allocations/{allocationId} {
      allow read: if isKnownUser();
      allow create, update: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Ward-wide community feed (community.html) — a single shared board any
    // signed-in staff member can post to and read. Author name/gender are
    // denormalized onto each post at write time (same approach as patient
    // fields on allocations) so the feed never needs a users/ lookup per
    // post. A post may only be edited/deleted by the nurse who wrote it —
    // never by another nurse, and not even by an admin, matching how the
    // Nurses Report history log treats authorship as untouchable.
    match /communityPosts/{postId} {
      allow read: if isKnownUser();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      // Replies on a post. Same authorship rule as the post itself — only
      // the comment's own author may edit or remove it.
      match /comments/{commentId} {
        allow read: if isKnownUser();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isSignedIn() && resource.data.uid == request.auth.uid;
      }
    }

    // Direct nurse-to-nurse messaging (messages.html). One conversation doc
    // per pair of nurses, id'd "dm_{uidA}_{uidB}" with uids sorted so the
    // same pair always lands on the same doc. `participants` is the source
    // of truth for access — only the two nurses in it may read/write the
    // conversation or its messages; nobody else, including admins, can see
    // private DMs. A message may only be edited/deleted by whoever sent it.
    // Nurse-to-nurse messaging (messages.html) — both direct 1:1 chats and
    // group chats live in the same conversations collection, distinguished
    // by `type: 'dm' | 'group'`. `participants` is the source of truth for
    // access on both: only the people in it may read/write the conversation,
    // its messages, or its typing indicators — nobody else, including
    // admins, can see private chats. DMs use a deterministic doc id
    // ("dm_{sortedUidA}_{sortedUidB}") so the same pair always lands on the
    // same thread; groups use an auto-generated id since membership isn't a
    // fixed pair. `readBy` (a map of uid -> last-read timestamp, seeded
    // empty at creation) drives read receipts, updated by each participant
    // for their own uid only as they open the thread.
    match /conversations/{convoId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && (request.resource.data.type == 'dm' ? request.resource.data.participants.size() == 2 : true)
        && (request.resource.data.type == 'group' ? request.resource.data.createdBy == request.auth.uid : true);
      allow update: if isSignedIn() && request.auth.uid in resource.data.participants && (
        // Updating the shared "last message" preview shown in the chat list.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageText', 'lastMessageAt', 'lastMessageSenderUid'])
        ||
        // Marking messages read — a participant may touch only her own key
        // in the readBy map, never anyone else's read timestamp.
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy.diff(resource.data.readBy).affectedKeys().hasOnly([request.auth.uid])
        )
        ||
        // Group membership/name changes — creator-managed only, and only
        // for groups; a DM's participants/type can never be altered.
        (
          resource.data.type == 'group' && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.type == resource.data.type
        )
      );
      allow delete: if false;

      // Per-user "is typing" flag. Anyone in the conversation can see who's
      // typing, but each nurse may only write her own typing doc.
      match /typing/{uid} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow write: if isSignedIn() && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          && request.resource.data.senderUid == request.auth.uid;
        // A message's own sender may edit/delete it outright. Any other
        // participant may still touch the doc, but ONLY to add/remove her
        // own reaction — never the text, image, or anyone else's content.
        allow update: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          && (
            resource.data.senderUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          );
        allow delete: if isSignedIn() && resource.data.senderUid == request.auth.uid;
      }
    }
  }
}
